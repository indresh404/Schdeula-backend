# ─────────────────────────────────────────────────────────────────
#  Schedula — .dockerignore
#  Excludes development, virtual environments, and temporary files
# ─────────────────────────────────────────────────────────────────

# Virtual environments
venv/
.venv/
env/
.env/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.coverage
htmlcov/
.tox/

# Git
.git/
.gitignore
.gitattributes

# IDE & OS files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Archives & logs
*.zip
*.tar.gz
*.log

# Temporary SQLite & backup checkpoints (data folder volume handles persistence)
data/checkpoints.db
data/schedula.db
data/backups/
data/audit_logs.json
data/scheduling_logs.json
data/draft_timetable.json

# Test files
tests/
